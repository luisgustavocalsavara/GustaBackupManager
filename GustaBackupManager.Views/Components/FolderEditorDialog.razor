@inject IFileTypeService FileTypeService
@inject IFolderCategoryConfigService CategoryConfigService

<MudDialog>
    <DialogContent>
        <div style="max-height: 76vh; overflow-y: auto; padding-right: 4px;">
            <SnackbarNotification @bind-Message="_errorMessage" Severity="Severity.Error" />

            @if (IsRootLevel)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3 d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Domain" Color="Color.Info" />
                    <MudText Typo="Typo.body2">Pasta Raiz: <b>Fábrica</b> (você pode cadastrar múltiplas fábricas na raiz do servidor SMB).</MudText>
                </MudPaper>
            }
            else if (!string.IsNullOrWhiteSpace(ParentDisplayPath))
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.body2">Localização pai: <b>@ParentDisplayPath</b></MudText>
                </MudPaper>
            }

            <MudGrid Spacing="2">
                <!-- SELEÇÃO DO TIPO DE PASTA E SUBCATEGORIA (QUANDO NÃO FOR FÁBRICA NA RAIZ) -->
                @if (!IsRootLevel)
                {
                    <MudItem xs="12" sm="@(HasSubCategory ? 6 : 12)">
                        <MudSelect T="FolderGroupType"
                                   Label="Tipo de Pasta"
                                   Value="_model.Group"
                                   ValueChanged="OnGroupChangedAsync"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var grp in NonRootGroups)
                            {
                                <MudSelectItem Value="@grp">@FolderIconCatalog.GetGroupLabel(grp)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @if (_model.Group == FolderGroupType.Localizacao)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="LocationSubCategory"
                                       Label="Categoria de Localização"
                                       Value="@(_model.LocationCategory ?? LocationSubCategory.Manufatura)"
                                       ValueChanged="OnLocationCategoryChangedAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (LocationSubCategory cat in Enum.GetValues<LocationSubCategory>())
                                {
                                    <MudSelectItem Value="@cat">@FolderIconCatalog.GetLocationCategoryLabel(cat)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else if (_model.Group == FolderGroupType.Projeto)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ProjectCategory" Label="Categoria de Projeto"
                                       Value="@(_model.ProjectInfo.Category ?? ProjectCategory.Clp)"
                                       ValueChanged="OnProjectCategoryChangedAsync"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (ProjectCategory cat in Enum.GetValues<ProjectCategory>())
                                {
                                    <MudSelectItem Value="@cat">@cat.GetLabel()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else if (_model.Group == FolderGroupType.Documentacao)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="DocumentationSubCategory"
                                       Label="Categoria de Documentação"
                                       Value="@(_model.DocumentationCategory ?? DocumentationSubCategory.ManualTecnico)"
                                       ValueChanged="OnDocumentationCategoryChangedAsync"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (DocumentationSubCategory cat in Enum.GetValues<DocumentationSubCategory>())
                                {
                                    <MudSelectItem Value="@cat">@FolderIconCatalog.GetDocumentationCategoryLabel(cat)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                }

                <!-- NOME DA PASTA E NOME RESUMIDO -->
                <MudItem xs="12" sm="6">
                    <MudTextField Value="_model.Name"
                                  ValueChanged="@((string val) => OnFolderNameManualInput(val))"
                                  Label="@(IsRootLevel ? "Nome da Fábrica" : "Nome da Pasta")"
                                  Placeholder="@GetNamePlaceholder()"
                                  HelperText="@GetNameHelperText()"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ShortName"
                                  Label="Nome Resumido (p/ nome do arquivo)"
                                  Placeholder="Ex.: Vin, Estoc, S01, CLP"
                                  HelperText="Opcional. Se vazio, usa o nome inteiro."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                @if (_model.Group is FolderGroupType.Projeto or FolderGroupType.Documentacao)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description"
                                      Label="Descrição / Observações"
                                      Placeholder="Descreva esta pasta..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2" />
                    </MudItem>
                }

                <!-- VISUALIZAÇÃO DO ÍCONE E COR CADASTRADOS NA CATEGORIA -->
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-2 d-flex flex-wrap align-center justify-space-between gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Color="@FolderIconCatalog.ResolveColor(_model.IconColor)" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@FolderIconCatalog.ResolveIcon(_model.IconKey)" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2">
                                    Ícone e cor aplicados automaticamente pela categoria configurada
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Para alterar o ícone ou a cor desta categoria, acesse <b>Ícones e Cores por Categoria</b> no menu.
                                </MudText>
                            </div>
                        </div>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@FolderIconCatalog.ResolveColor(_model.IconColor)"
                                 Variant="Variant.Outlined">
                            @GetCurrentCategorySummary()
                        </MudChip>
                    </MudPaper>
                </MudItem>

                <!-- PRÉVIA DO NOME DO ARQUIVO -->
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3 d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Color="Color.Success" />
                        <div>
                            <MudText Typo="Typo.caption" Class="d-block">
                                Prévia do nome automático do arquivo nesta hierarquia (caminho + data/hora):
                            </MudText>
                            <code>@BuildLiveFileNamePreview()</code>
                        </div>
                    </MudPaper>
                </MudItem>

                <!-- CAMPOS ESPECÍFICOS POR TIPO DE PASTA -->
                @if (_model.Group is not (FolderGroupType.Projeto or FolderGroupType.Documentacao))
                {
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3">
                        @if (_model.Group == FolderGroupType.Fabrica)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Dados da Fábrica (gravados em folder.meta.json)</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="7">
                                    <MudTextField @bind-Value="_model.FactoryInfo.RazaoSocial"
                                                  Label="Razão Social"
                                                  Placeholder="Ex.: Indústria Exemplo S.A."
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="5">
                                    <MudTextField @bind-Value="_model.FactoryInfo.Cnpj"
                                                  Label="CNPJ"
                                                  Placeholder="Ex.: 12.345.678/0001-90"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.FactoryInfo.Endereco"
                                                  Label="Endereço"
                                                  Placeholder="Rua, número, bairro, cidade - UF, CEP"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.FactoryInfo.Informacoes"
                                                  Label="Informações sobre a Fábrica"
                                                  Placeholder="Observações gerais da planta, turnos, contatos técnicos..."
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="2" />
                                </MudItem>
                            </MudGrid>
                        }
                        else if (_model.Group == FolderGroupType.Equipamento)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Dados do Equipamento (gravados em folder.meta.json)</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.EquipmentInfo.Fabricante"
                                                  Label="Fabricante"
                                                  Placeholder="Ex.: Krones, Sidel, Tetra Pak"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.EquipmentInfo.Modelo"
                                                  Label="Modelo"
                                                  Placeholder="Ex.: Variopac Pro FS"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.EquipmentInfo.AnoFabricacao"
                                                  Label="Ano de Fabricação"
                                                  Placeholder="Ex.: 2023"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.EquipmentInfo.NumeroSerie"
                                                  Label="Número de Série"
                                                  Placeholder="Ex.: SN-2023-88412"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Informações da Pasta</MudText>
                            <MudTextField @bind-Value="_model.Description"
                                          Label="Descrição (gravada em folder.meta.json)"
                                          Placeholder="Descreva os detalhes desta pasta..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="2" />
                        }
                    </MudPaper>
                </MudItem>
                }

                <!-- REGRA DE ARMAZENAMENTO DE ARQUIVOS -->
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3">
                        @if (!AllowsFileStorage)
                        {
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.FolderShared" Color="Color.Info" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">Pasta Estrutural (Organização)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Pastas do tipo <b>@FolderIconCatalog.GetGroupLabel(_model.Group)</b> organizam a hierarquia.
                                        Para armazenar arquivos, crie subpastas da categoria <b>Projeto</b> ou <b>Documentação</b>.
                                    </MudText>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Success" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">Repositório de Arquivos (@FolderIconCatalog.GetGroupLabel(_model.Group))</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        As extensões permitidas são determinadas pelos repositórios selecionados:
                                    </MudText>
                                </div>
                            </div>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                @( _model.Group == FolderGroupType.Projeto
                                    ? "Selecione um único repositório; as extensões cadastradas serão aplicadas à pasta."
                                    : "Selecione os repositórios que esta pasta poderá armazenar.")
                            </MudText>
                            <MudTextField @bind-Value="_repositorySearchText"
                                          Placeholder="Buscar por nome, extensão ou descrição..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Clearable="true"
                                          Immediate="true"
                                          Class="mb-2" />
                            @if (AvailableFileTypes.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Nenhum repositório corresponde à busca. Cadastre tipos e extensões no Cadastro de Tipos de Arquivo para Repositórios.
                                </MudText>
                            }
                            else
                            {
                                <MudGrid Spacing="2" Class="mb-2">
                                    @foreach (var ft in AvailableFileTypes)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Outlined="true" Class="pa-3 h-100">
                                                <div class="d-flex align-start gap-2">
                                                    <MudCheckBox T="bool"
                                                                 Value="@IsRepositoryTypeSelected(ft.Id)"
                                                                 ValueChanged="@((bool selected) => OnRepositoryFileTypeCheckboxChangedAsync(ft.Id, selected))"
                                                                 Dense="true"
                                                                 Color="Color.Primary"
                                                                 Class="mt-n1" />
                                                    <MudIcon Icon="@FolderIconCatalog.ResolveIcon(ft.IconKey)" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
                                                    <div class="flex-grow-1">
                                                        <MudText Typo="Typo.body2"><b>@ft.Name</b></MudText>
                                                        @if (!string.IsNullOrWhiteSpace(ft.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Class="d-block mt-1">@ft.Description</MudText>
                                                        }
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                                                            <b>Extensões:</b> @string.Join(" · ", ft.GetNormalizedExtensions())
                                                        </MudText>
                                                    </div>
                                                </div>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }

                            @if (_model.Group == FolderGroupType.Projeto)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                                    Extensões liberadas pelo tipo selecionado
                                </MudText>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var extension in GetSelectedProjectExtensions())
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                            @extension
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Para alterar as extensões, edite o tipo no Cadastro de Tipos de Arquivo para Repositórios.
                                </MudText>
                            }

                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">
            @(IsEditMode ? "Salvar Alterações" : "Criar Pasta")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public bool IsEditMode { get; set; }

    [Parameter]
    public bool IsRootLevel { get; set; }

    [Parameter]
    public string? ParentDisplayPath { get; set; }

    [Parameter]
    public string? ParentNamingPrefix { get; set; }

    [Parameter]
    public FolderMetadata? InitialMetadata { get; set; }

    private static readonly FolderGroupType[] NonRootGroups =
    [
        FolderGroupType.Localizacao,
        FolderGroupType.Equipamento,
        FolderGroupType.Projeto,
        FolderGroupType.Documentacao
    ];

    private FolderEditRequest _model = new();
    private List<FileTypeDefinition> _allFileTypes = [];
    private List<FileTypeDefinition> _fileTypes = [];
    private List<FileTypeDefinition> _projectFileTypes = [];
    private HashSet<int> _selectedTypeIds = [];
    private string _repositorySearchText = string.Empty;
    private string? _errorMessage;
    private bool _hasAutoAssignedName;

    private bool HasSubCategory =>
        _model.Group is FolderGroupType.Localizacao or FolderGroupType.Projeto or FolderGroupType.Documentacao;

    private bool AllowsFileStorage =>
        _model.Group is FolderGroupType.Projeto or FolderGroupType.Documentacao;

    private List<FileTypeDefinition> AvailableFileTypes => FilterFileTypes(
        _model.Group == FolderGroupType.Projeto
            ? _projectFileTypes
            : _allFileTypes.Where(type => type.IsActive || _selectedTypeIds.Contains(type.Id)));

    private bool IsRepositoryTypeSelected(int id) =>
        _model.Group == FolderGroupType.Projeto
            ? _model.ProjectInfo.FileTypeId == id
            : _selectedTypeIds.Contains(id);

    private List<FileTypeDefinition> FilterFileTypes(IEnumerable<FileTypeDefinition> fileTypes)
    {
        var search = _repositorySearchText.Trim();
        return fileTypes
            .Where(type => string.IsNullOrWhiteSpace(search) ||
                type.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (type.Extensions ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (type.Description ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _allFileTypes = await FileTypeService.GetAllAsync(onlyActive: false);
        _fileTypes = _allFileTypes.Where(type => type.IsActive).ToList();

        if (IsEditMode && InitialMetadata is not null)
        {
            _model = new FolderEditRequest
            {
                Name = InitialMetadata.Name,
                ShortName = InitialMetadata.ShortName,
                Description = InitialMetadata.Description,
                Group = IsRootLevel ? FolderGroupType.Fabrica : InitialMetadata.Group,
                LocationCategory = InitialMetadata.LocationCategory ?? LocationSubCategory.Manufatura,
                ProjectInfo = InitialMetadata.ProjectInfo is null
                    ? new ProjectMetadataDetails { Category = ProjectCategory.Clp, ProjectName = InitialMetadata.Name, AllowedExtensions = string.Join(";", InitialMetadata.AllowedExtensions) }
                    : new ProjectMetadataDetails
                    {
                        FileTypeId = InitialMetadata.ProjectInfo.FileTypeId,
                        Category = InitialMetadata.ProjectInfo.Category ?? ProjectCategory.Clp,
                        ProjectName = InitialMetadata.ProjectInfo.ProjectName,
                        AllowedExtensions = InitialMetadata.ProjectInfo.AllowedExtensions
                    },
                DocumentationCategory = InitialMetadata.DocumentationCategory ?? DocumentationSubCategory.ManualTecnico,
                IconKey = InitialMetadata.IconKey,
                IconColor = InitialMetadata.IconColor,
                FactoryInfo = InitialMetadata.FactoryInfo is null
                    ? new FactoryMetadataDetails { Informacoes = InitialMetadata.Description }
                    : new FactoryMetadataDetails
                    {
                        RazaoSocial = InitialMetadata.FactoryInfo.RazaoSocial,
                        Cnpj = InitialMetadata.FactoryInfo.Cnpj,
                        Endereco = InitialMetadata.FactoryInfo.Endereco,
                        Informacoes = InitialMetadata.FactoryInfo.Informacoes
                    },
                EquipmentInfo = InitialMetadata.EquipmentInfo is null
                    ? new EquipmentMetadataDetails()
                    : new EquipmentMetadataDetails
                    {
                        Fabricante = InitialMetadata.EquipmentInfo.Fabricante,
                        Modelo = InitialMetadata.EquipmentInfo.Modelo,
                        AnoFabricacao = InitialMetadata.EquipmentInfo.AnoFabricacao,
                        NumeroSerie = InitialMetadata.EquipmentInfo.NumeroSerie
                    },
                AllowedFileTypeIds = [.. InitialMetadata.AllowedFileTypeIds]
            };

            _selectedTypeIds = [.. InitialMetadata.AllowedFileTypeIds];

            RestoreProjectFileTypeSelection();
            await RefreshAppearanceFromCategoryConfigAsync();
        }
        else if (IsRootLevel)
        {
            _model.Group = FolderGroupType.Fabrica;
            await RefreshAppearanceFromCategoryConfigAsync();
        }
        else
        {
            _model.Group = FolderGroupType.Localizacao;
            _model.LocationCategory = LocationSubCategory.Manufatura;
            await RefreshAppearanceFromCategoryConfigAsync();
        }

        RefreshProjectFileTypes();
    }

    private void OnFolderNameManualInput(string value)
    {
        _model.Name = value;
        _hasAutoAssignedName = false;
    }

    private async Task RefreshAppearanceFromCategoryConfigAsync()
    {
        var (iconKey, iconColor) = await CategoryConfigService.ResolveAppearanceAsync(
            _model.Group,
            _model.LocationCategory,
            _model.ProjectInfo.Category,
            _model.DocumentationCategory);

        _model.IconKey = iconKey;
        _model.IconColor = iconColor;
    }

    private string GetCurrentCategorySummary() =>
        _model.Group switch
        {
            FolderGroupType.Localizacao => $"Localização - {FolderIconCatalog.GetLocationCategoryLabel(_model.LocationCategory ?? LocationSubCategory.Manufatura)}",
            FolderGroupType.Projeto => (_model.ProjectInfo.Category ?? ProjectCategory.Clp).GetLabel(),
            FolderGroupType.Documentacao => $"Documentação - {FolderIconCatalog.GetDocumentationCategoryLabel(_model.DocumentationCategory ?? DocumentationSubCategory.ManualTecnico)}",
            _ => FolderIconCatalog.GetGroupLabel(_model.Group)
        };

    private string GetNamePlaceholder() =>
        _model.Group switch
        {
            FolderGroupType.Fabrica => "Ex.: Fábrica Vinhedo",
            FolderGroupType.Localizacao => "Ex.: Estocagem ou Setor 01",
            FolderGroupType.Equipamento => "Ex.: Encaixotador",
            FolderGroupType.Projeto => "Ex.: Projeto CLP Linha 01",
            FolderGroupType.Documentacao => "Ex.: Diagrama Elétrico",
            _ => "Ex.: Arquivos Gerais"
        };

    private string GetNameHelperText() =>
        _model.Group is FolderGroupType.Projeto or FolderGroupType.Documentacao
            ? "Você pode editar o nome para identificar a instância do projeto (ex.: CLP Linha 01)."
            : "Nome da pasta que será criada no servidor SMB.";

    private async Task OnGroupChangedAsync(FolderGroupType group)
    {
        if (IsRootLevel)
        {
            _model.Group = FolderGroupType.Fabrica;
            return;
        }

        _model.Group = group;
        if (group == FolderGroupType.Localizacao)
        {
            _model.LocationCategory ??= LocationSubCategory.Manufatura;
            if (_hasAutoAssignedName)
            {
                _model.Name = string.Empty;
                _hasAutoAssignedName = false;
            }
        }
        else if (group == FolderGroupType.Projeto)
        {
            _model.ProjectInfo.Category ??= ProjectCategory.Clp;
            RefreshProjectFileTypes();
            _model.Name = _model.ProjectInfo.Category.Value.GetName();
            _hasAutoAssignedName = true;
        }
        else if (group == FolderGroupType.Documentacao)
        {
            _model.DocumentationCategory ??= DocumentationSubCategory.ManualTecnico;
            _model.Name = FolderIconCatalog.GetDocumentationCategoryLabel(_model.DocumentationCategory.Value);
            _hasAutoAssignedName = true;
        }
        else if (_hasAutoAssignedName)
        {
            _model.Name = string.Empty;
            _hasAutoAssignedName = false;
        }

        await RefreshAppearanceFromCategoryConfigAsync();
    }

    private async Task OnLocationCategoryChangedAsync(LocationSubCategory category)
    {
        _model.LocationCategory = category;
        await RefreshAppearanceFromCategoryConfigAsync();
    }

    private async Task OnProjectCategoryChangedAsync(ProjectCategory category)
    {
        _model.ProjectInfo.Category = category;
        var selectedType = _allFileTypes.FirstOrDefault(type => type.Id == _model.ProjectInfo.FileTypeId);
        _model.ProjectInfo.ProjectName = selectedType is null
            ? category.GetLabel()
            : $"{category.GetLabel()} ({selectedType.Name})";
        _model.ProjectInfo.AllowedExtensions = selectedType is null
            ? string.Empty
            : string.Join(";", selectedType.GetNormalizedExtensions());
        RefreshProjectFileTypes();
        if (_hasAutoAssignedName || string.IsNullOrWhiteSpace(_model.Name))
        {
            _model.Name = category.GetName();
            _hasAutoAssignedName = true;
        }
        await RefreshAppearanceFromCategoryConfigAsync();
    }

    private Task OnRepositoryFileTypeCheckboxChangedAsync(int id, bool isSelected)
    {
        if (_model.Group == FolderGroupType.Projeto)
            return OnProjectFileTypeCheckboxChangedAsync(id, isSelected);

        ToggleFileType(id, isSelected);
        return Task.CompletedTask;
    }

    private Task OnProjectFileTypeCheckboxChangedAsync(int id, bool isSelected)
    {
        if (isSelected)
        {
            var selectedType = _projectFileTypes.FirstOrDefault(type => type.Id == id);
            if (selectedType is null)
                return Task.CompletedTask;

            _model.ProjectInfo.FileTypeId = selectedType.Id;
            _model.ProjectInfo.ProjectName = $"{_model.ProjectInfo.Category?.GetLabel()} ({selectedType.Name})";
            _model.ProjectInfo.AllowedExtensions = string.Join(";", selectedType.GetNormalizedExtensions());
        }
        else if (_model.ProjectInfo.FileTypeId == id)
        {
            _model.ProjectInfo.FileTypeId = null;
            _model.ProjectInfo.ProjectName = _model.ProjectInfo.Category?.GetLabel() ?? string.Empty;
            _model.ProjectInfo.AllowedExtensions = string.Empty;
        }

        return Task.CompletedTask;
    }

    private void RefreshProjectFileTypes()
    {
        _projectFileTypes = _allFileTypes
            .Where(type => type.IsActive || type.Id == _model.ProjectInfo.FileTypeId)
            .ToList();
    }

    private void RestoreProjectFileTypeSelection()
    {
        var matchingType = _allFileTypes.FirstOrDefault(type => type.Id == _model.ProjectInfo.FileTypeId);
        if (matchingType is null && !string.IsNullOrWhiteSpace(_model.ProjectInfo.ProjectName))
        {
            matchingType = _allFileTypes.FirstOrDefault(type =>
                _model.ProjectInfo.ProjectName.Contains(type.Name, StringComparison.OrdinalIgnoreCase));
        }

        if (matchingType is not null)
        {
            _model.ProjectInfo.FileTypeId = matchingType.Id;
            _model.ProjectInfo.ProjectName = $"{_model.ProjectInfo.Category?.GetLabel()} ({matchingType.Name})";
            _model.ProjectInfo.AllowedExtensions = string.Join(";", matchingType.GetNormalizedExtensions());
        }

        RefreshProjectFileTypes();
    }

    private async Task OnDocumentationCategoryChangedAsync(DocumentationSubCategory category)
    {
        _model.DocumentationCategory = category;
        _model.Name = FolderIconCatalog.GetDocumentationCategoryLabel(category);
        _hasAutoAssignedName = true;
        await RefreshAppearanceFromCategoryConfigAsync();
    }

    private List<string> GetSelectedProjectExtensions() =>
        string.IsNullOrWhiteSpace(_model.ProjectInfo.AllowedExtensions)
            ? []
            : _model.ProjectInfo.AllowedExtensions
                .Split([';', ',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(extension => extension.StartsWith('.') ? extension : $".{extension}")
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(extension => extension, StringComparer.OrdinalIgnoreCase)
                .ToList();

    private string BuildLiveFileNamePreview()
    {
        var prefix = FolderNameHelper.ComposePrefix(ParentNamingPrefix, _model.ShortName, _model.Name);
        var sampleExt = GetSampleExtension();
        return FolderNameHelper.FormatPreviewFileName(prefix, sampleExt);
    }

    private string GetSampleExtension()
    {
        if (!AllowsFileStorage)
            return ".acd";

        var selectedTypes = _model.Group == FolderGroupType.Projeto
            ? _allFileTypes.Where(type => type.Id == _model.ProjectInfo.FileTypeId)
            : _fileTypes.Where(type => _selectedTypeIds.Contains(type.Id));
        var fromCatalog = selectedTypes
            .SelectMany(type => type.GetNormalizedExtensions())
            .FirstOrDefault();

        return !string.IsNullOrWhiteSpace(fromCatalog) ? fromCatalog : ".ext";
    }

    private void ToggleFileType(int id, bool selected)
    {
        if (selected) _selectedTypeIds.Add(id);
        else _selectedTypeIds.Remove(id);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = IsRootLevel ? "Informe o nome da fábrica." : "Informe o nome da pasta.";
            return;
        }

        if (IsRootLevel)
            _model.Group = FolderGroupType.Fabrica;

        _model.AllowedFileTypeIds = AllowsFileStorage && _model.Group != FolderGroupType.Projeto ? [.. _selectedTypeIds] : [];

        if (_model.Group == FolderGroupType.Projeto && !_model.ProjectInfo.FileTypeId.HasValue)
        {
            _errorMessage = "Selecione um repositório cadastrado para o software.";
            return;
        }

        if (AllowsFileStorage && _model.Group != FolderGroupType.Projeto &&
            _model.AllowedFileTypeIds.Count == 0)
        {
            _errorMessage = "Selecione ao menos um repositório cadastrado para definir as extensões permitidas.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(_model));
    }
}
