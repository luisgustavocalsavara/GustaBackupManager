    private static string DisplayOrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetPatternPreview(FolderTreeNode node)
    {
        var ext = node.Metadata.AllowedExtensions.FirstOrDefault() ?? ".ext";
        return string.IsNullOrWhiteSpace(node.NamingPrefix)
            ? $"yyyyMMdd_HHmmss{ext}"
            : $"{node.NamingPrefix}_yyyyMMdd_HHmmss{ext}";
    }

    private static string SerializeMetadataPreview(FolderMetadata metadata) =>
        JsonSerializer.Serialize(metadata, PreviewJsonOptions);

    private static string? GetEndBadgeText(FolderTreeNode? node)
    {
        if (node is null) return null;
        if (node.FileCount > 0) return $"{node.FileCount}";
        return node.Metadata.AllowFileStorage ? "0" : null;
    }

    private static FolderTreeNode? FindNodeByPath(IEnumerable<FolderTreeNode> nodes, string fullPath)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.FullPath, fullPath, StringComparison.OrdinalIgnoreCase))
                return node;

            var child = FindNodeByPath(node.Children, fullPath);
            if (child is not null)
                return child;
        }
        return null;
    }

    private static string FindParentPrefix(IEnumerable<FolderTreeNode> nodes, string targetFullPath, string currentParentPrefix)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.FullPath, targetFullPath, StringComparison.OrdinalIgnoreCase))
                return currentParentPrefix;

            var nested = FindParentPrefix(node.Children, targetFullPath, node.NamingPrefix);
            if (!string.IsNullOrEmpty(nested) || ContainsNode(node.Children, targetFullPath))
                return nested;
        }
        return string.Empty;
    }

    private static bool ContainsNode(IEnumerable<FolderTreeNode> nodes, string targetFullPath)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.FullPath, targetFullPath, StringComparison.OrdinalIgnoreCase))
                return true;
            if (ContainsNode(node.Children, targetFullPath))
                return true;
        }
        return false;
    }
